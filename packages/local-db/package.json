{
  "name": "@operon/local-db",
  "version": "1.0.0",
  "description": "Local-first SQLite storage, Multi-database Drizzle ORM client, schemas, and offline sync for Operon",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:test-sync": "node scripts/test-local-db-sync.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/automation": "./src/schema/automation.ts",
    "./schema/system": "./src/schema/system.ts",
    "./schema/tenants": "./src/schema/tenants.ts",
    "./sync": "./src/sync.ts"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@operon/constants": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
