{
  "name": "@operon/plugins",
  "version": "5.8.0",
  "homepage": "https://github.com/operon/console",
  "bugs": "https://github.com/operon/console/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/operon/console.git",
    "directory": "packages/effects/plugins"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./echarts": {
      "types": "./src/echarts/index.ts",
      "default": "./src/echarts/index.ts"
    },
    "./vxe-table": {
      "types": "./src/vxe-table/index.ts",
      "default": "./src/vxe-table/index.ts"
    },
    "./motion": {
      "types": "./src/motion/index.ts",
      "default": "./src/motion/index.ts"
    }
  },
  "dependencies": {
    "@operon-core/design": "workspace:*",
    "@operon-core/form-ui": "workspace:*",
    "@operon-core/shadcn-ui": "workspace:*",
    "@operon-core/shared": "workspace:*",
    "@operon-core/typings": "workspace:*",
    "@operon/hooks": "workspace:*",
    "@operon/icons": "workspace:*",
    "@operon/locales": "workspace:*",
    "@operon/preferences": "workspace:*",
    "@operon/types": "workspace:*",
    "@operon/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "@vueuse/motion": "catalog:",
    "echarts": "catalog:",
    "vue": "catalog:",
    "vxe-pc-ui": "catalog:",
    "vxe-table": "catalog:"
  }
}
