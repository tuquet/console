{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Operon Workstation",
  "version": "5.8.0",
  "identifier": "com.operon.workstation",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5320",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://*.operon.com http://127.0.0.1:* ws://127.0.0.1:* https://api.iconify.design https://api.unisvg.com https://api.simplesvg.com https://challenges.cloudflare.com; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:;",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["operon"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NUZBNzE0NEFCOTE5QzMKUldUREdibEtGS2RmaG1SSGtqdnJOZXdTSEx6cXIrdXlNV0xxb2FLZytkUzYxSGptNFJ4WnlTYzQK",
      "endpoints": [
        "https://github.com/tuquet/console/releases/latest/download/latest.json"
      ]
    }
  }
}
