# Port
VITE_PORT=5666

VITE_BASE=/

# API endpoint URL
VITE_GLOB_API_URL=/api

# Nitro Mock service toggle (true: enable, false: disable)
VITE_NITRO_MOCK=false

# DevTools toggle (true: open, false: closed)
VITE_DEVTOOLS=false

# Global loading injection toggle
VITE_INJECT_APP_LOADING=true

# Disable Sentry / Bugsink telemetry in development
VITE_BUGSINK_ENABLED=false

