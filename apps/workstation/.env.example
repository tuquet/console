# ==============================================================================
# WORKSTATION WEB CONSOLE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Architecture: Single Sign-On (SSO) via id.tuquet.com & Local Operon Bridge
# ==============================================================================

# Application Meta
VITE_APP_TITLE=Tuquet Console
VITE_APP_NAMESPACE=admin

# Development Server Port
VITE_PORT=5666

# Local Operon Daemon WebSocket Bridge
VITE_DAEMON_PORT=8765
VITE_DAEMON_URL=ws://127.0.0.1:8765

# ------------------------------------------------------------------------------
# Central ID SSOT (Supabase Auth & RLS REST Client)
# ------------------------------------------------------------------------------
# Development: http://127.0.0.1:55321
# Production:  https://id.tuquet.com
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_API_URL=http://127.0.0.1:55321/rest/v1

# ------------------------------------------------------------------------------
# Seamless SSO Cookie Domain Scope
# ------------------------------------------------------------------------------
# Development: leave empty
# Production:  .tuquet.com
VITE_COOKIE_DOMAIN=

# Optional: Cloudflare Turnstile Bot Protection
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: Telemetry & Error Tracking
VITE_BUGSINK_ENABLED=false
VITE_BUGSINK_DSN=
