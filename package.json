{
  "name": "@operon/console",
  "version": "5.8.0",
  "private": true,
  "keywords": [
    "operon",
    "admin",
    "vue3",
    "dashboard",
    "shadcn"
  ],
  "homepage": "https://console.operon.com",
  "bugs": "https://github.com/operon/console/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/operon/console.git"
  },
  "license": "MIT",
  "author": "operon",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F @operon/shell run dev",
    "dev:shell": "pnpm -F @operon/shell run dev",
    "dev:desktop": "pnpm -F @operon/shell run tauri:dev",
    "dev:automation": "pnpm -F @operon/automation run dev",
    "dev:system": "pnpm -F @operon/system run dev",
    "dev:tenants": "pnpm -F @operon/tenants run dev",
    "dev:web": "pnpm -F @operon/shell run dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=3072 turbo build --concurrency=1",
    "build:shell": "pnpm -F @operon/shell run build",
    "build:desktop": "pnpm -F @operon/shell run tauri:build",
    "build:desktop:exe": "pnpm -F @operon/shell run tauri:build:exe",
    "build:automation": "pnpm -F @operon/automation run build",
    "build:system": "pnpm -F @operon/system run build",
    "build:tenants": "pnpm -F @operon/tenants run build",
    "build:analyze": "turbo build:analyze --concurrency=1",
    "build:local": "bash ./scripts/build-local.sh",
    "preview": "turbo-run preview",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:benchmark": "vitest bench --run",
    "lint": "vsh lint",
    "format": "vsh lint --format",
    "publint": "vsh publint",
    "check": "pnpm run check:architecture && pnpm run check:circular && pnpm run check:dep && pnpm run check:i18n && pnpm run check:type && pnpm check:cspell",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:circular": "vsh check-circular",
    "check:console": "node ./scripts/check-console.mjs",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "check:type": "pnpm run check:type-coverage && turbo run typecheck --concurrency=1",
    "check:type-coverage": "node scripts/check-typecheck-coverage.mjs",
    "desktop:check": "node scripts/check-desktop.mjs",
    "tauri:check": "cd apps/shell/src-tauri && cargo check",
    "db:generate": "pnpm -F @operon/local-db run db:generate",
    "db:push": "pnpm -F @operon/local-db run db:push",
    "db:studio": "pnpm -F @operon/local-db run db:studio",
    "db:test-sync": "pnpm -F @operon/local-db run db:test-sync",
    "gen:app": "node scripts/gen-micro-app.mjs",
    "gen:micro-app": "node scripts/gen-micro-app.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:check": "node scripts/release/version.mjs --check",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:package": "node scripts/package-portable.mjs",
    "release:verify": "node scripts/release/artifacts.mjs --verify",
    "release:publish": "node scripts/release/publish.mjs",
    "release:manage": "node scripts/release/state.mjs",
    "updater:simulate": "node scripts/simulate-updater.mjs",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "commit": "czg",
    "changeset": "pnpm exec changeset",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "update:deps": "npx taze -r -w",
    "prepare": "is-ci || pnpm exec lefthook install --force || true",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm -r run --if-present stub",
    "build:playground": "pnpm -F @operon/playground run build",
    "dev:playground": "pnpm -F @operon/playground run dev"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@operon/commitlint-config": "workspace:*",
    "@operon/eslint-config": "workspace:*",
    "@operon/oxfmt-config": "workspace:*",
    "@operon/oxlint-config": "workspace:*",
    "@operon/stylelint-config": "workspace:*",
    "@operon/tailwind-config": "workspace:*",
    "@operon/tsconfig": "workspace:*",
    "@operon/turbo-run": "workspace:*",
    "@operon/vite-config": "workspace:*",
    "@operon/vsh": "workspace:*",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
